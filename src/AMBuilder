import os

project = builder.LibraryProject('tickrate_enabler')
project.sources += [
  'thirdparty/codepatch/patchmanager.cpp',
  'tickrate_enabler.cpp', 
  'thirdparty/memutils.cpp',
  'maxrate_patches.cpp',
  'boomervomitpatch.cpp',
]

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]
  if sdk['name'] in ['mock']:
    continue

  for cxx in builder.targets:
    if not cxx.target.arch in sdk['platforms'][cxx.target.platform]:
      continue
    
    binary = Extension.HL2Config(project, builder, cxx, 'tickrate_enabler', sdk)
    binary.compiler.cxxincludes += [os.path.join(builder.sourcePath, 'thirdparty', 'khook', 'include')]

    binary.compiler.defines += ['KHOOK_STANDALONE', 'KHOOK_EXPORT']
    for task in Extension.libkhook:
      if task.target.arch == binary.compiler.target.arch:
       binary.compiler.linkflags += [task.binary]
    for task in Extension.libsafetyhook:
      if task.target.arch == binary.compiler.target.arch:
        binary.compiler.linkflags += [task.binary]

Extension.extensions += builder.Add(project)
